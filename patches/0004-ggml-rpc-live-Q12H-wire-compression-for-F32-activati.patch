From f1149f0127f30989b7a7150755e10337f9052e9f Mon Sep 17 00:00:00 2001
From: wcarsond <wcarsond@users.noreply.github.com>
Date: Mon, 9 Nov 2026 22:58:55 -0500
Subject: [PATCH 4/6] ggml-rpc: opt-in Q12H wire compression for F32
 activations (GGML_RPC_WIRE_Q12H=1) and bump RPC protocol to 8.0.2

---
 ggml/include/ggml-rpc.h        |  2 +-
 ggml/src/ggml-rpc/ggml-rpc.cpp | 68 ++++++++++++++++++++++++++++++++++++++----
 2 files changed, 63 insertions(+), 7 deletions(-)

diff --git a/ggml/include/ggml-rpc.h b/ggml/include/ggml-rpc.h
index ecf0a3a6d..cbb9d5237 100644
--- a/ggml/include/ggml-rpc.h
+++ b/ggml/include/ggml-rpc.h
@@ -8,7 +8,7 @@ extern "C" {
 
 #define RPC_PROTO_MAJOR_VERSION    8
 #define RPC_PROTO_MINOR_VERSION    0
-#define RPC_PROTO_PATCH_VERSION    1
+#define RPC_PROTO_PATCH_VERSION    2
 
 #ifdef  __cplusplus
 static_assert(GGML_OP_COUNT == 102, "GGML_OP_COUNT has changed - update RPC_PROTO_PATCH_VERSION");
diff --git a/ggml/src/ggml-rpc/ggml-rpc.cpp b/ggml/src/ggml-rpc/ggml-rpc.cpp
index 5cedd89ad..d7de0b2a4 100644
--- a/ggml/src/ggml-rpc/ggml-rpc.cpp
+++ b/ggml/src/ggml-rpc/ggml-rpc.cpp
@@ -2,6 +2,7 @@
 #include "ggml-impl.h"
 #include "ggml-backend-impl.h"
 #include "ggml-cpp.h"
+#include "ggml-quants.h"
 #include "transport.h"
 #include "auth.h"
 #include "log.h"
@@ -831,7 +832,29 @@ static void ggml_backend_rpc_buffer_memset_tensor(
 }
 
 // input serialization format: | rpc_tensor | cache_flag (1 byte) | offset (8 bytes) | data (size bytes)
+// When cache_flag == 2, `data` is an F32 activation tensor compressed on the wire as Q12H (2.5x smaller than F32)!
+// LOSSY and therefore opt-in (GGML_RPC_WIRE_Q12H=1, read on the client): F32 activations are cut to 16 bits and
+// outliers beyond a block's 4 exception slots are snapped. Measured 2026-11-10 on the 30B QL+Q8 over RPC:
+// wire on against wire off = mean KLD 0.000971, same top token 99.098% (off against off repeats exactly).
+static bool rpc_can_q12h_wire(const ggml_tensor * tensor, size_t size) {
+    static const bool enabled = getenv("GGML_RPC_WIRE_Q12H") != nullptr && atoi(getenv("GGML_RPC_WIRE_Q12H")) != 0;
+    return enabled && tensor->type == GGML_TYPE_F32 && tensor->buffer->usage != GGML_BACKEND_BUFFER_USAGE_WEIGHTS &&
+           size >= 4096 && (size % (QK12H * sizeof(float)) == 0);
+}
+
 static std::shared_ptr<uint8_t> serialize_set_tensor(const rpc_tensor & rpc_tensor, uint8_t cache_flag, uint64_t offset, const void * data, size_t size, size_t & input_size) {
+    if (cache_flag == 2) {
+        const size_t n_floats = size / sizeof(float);
+        const size_t q_bytes  = (n_floats / QK12H) * sizeof(block_q12h);
+        input_size = sizeof(rpc_tensor) + sizeof(cache_flag) + sizeof(offset) + q_bytes;
+        uint8_t * input = new uint8_t[input_size]();
+        uint8_t * p = input;
+        memcpy(p, &rpc_tensor, sizeof(rpc_tensor)); p += sizeof(rpc_tensor);
+        memcpy(p, &cache_flag, sizeof(cache_flag)); p += sizeof(cache_flag);
+        memcpy(p, &offset,     sizeof(offset));     p += sizeof(offset);
+        quantize_row_q12h_ref((const float *)data, (block_q12h *)p, (int64_t)n_floats);
+        return std::shared_ptr<uint8_t>(input, std::default_delete<uint8_t[]>());
+    }
     input_size = sizeof(rpc_tensor) + sizeof(cache_flag) + sizeof(offset) + size;
     uint8_t * input = new uint8_t[input_size]();
     uint8_t * p = input;
@@ -871,6 +894,8 @@ static void ggml_backend_rpc_buffer_set_tensor(ggml_backend_buffer_t buffer, ggm
         }
         // the server has no cache entry for this tensor - ask it to save one
         cache_flag = 1;
+    } else if (rpc_can_q12h_wire(tensor, size)) {
+        cache_flag = 2;
     }
     size_t input_size;
     auto input = serialize_set_tensor(rpc_tensor, cache_flag, offset, data, size, input_size);
@@ -928,6 +953,16 @@ static void ggml_backend_rpc_buffer_get_tensor(ggml_backend_buffer_t buffer, con
     auto request = std::make_shared<rpc_msg_get_tensor_req>();
     request->tensor = serialize_tensor(tensor);
     request->offset = offset;
+    if (rpc_can_q12h_wire(tensor, size)) {
+        // High bit on request->size signals Q12H wire compression for this F32 activation fetch!
+        const size_t n_floats = size / sizeof(float);
+        const size_t q_bytes  = (n_floats / QK12H) * sizeof(block_q12h);
+        request->size = size | (1ULL << 62);
+        std::vector<uint8_t> q_buf(q_bytes);
+        ctx->dispatcher->send(RPC_CMD_GET_TENSOR, request, sizeof(*request), q_buf.data(), q_bytes);
+        dequantize_row_q12h((const block_q12h *)q_buf.data(), (float *)data, (int64_t)n_floats);
+        return;
+    }
     request->size = size;
     ctx->dispatcher->send(RPC_CMD_GET_TENSOR, request, sizeof(*request), data, size);
 }
@@ -1172,6 +1207,8 @@ static void ggml_backend_rpc_set_tensor_async(ggml_backend_t backend, ggml_tenso
         }
         // the server has no cache entry for this tensor - ask it to save one
         cache_flag = 1;
+    } else if (rpc_can_q12h_wire(tensor, size)) {
+        cache_flag = 2;
     }
     size_t input_size;
     auto input = serialize_set_tensor(rpc_tensor, cache_flag, offset, data, size, input_size);
@@ -1712,7 +1749,7 @@ bool rpc_server::set_tensor(const std::vector<uint8_t> & input) {
     const rpc_tensor * in_tensor = (const rpc_tensor *)input.data();
     memcpy(&cache_flag, input.data() + sizeof(rpc_tensor), sizeof(cache_flag));
     memcpy(&offset,     input.data() + sizeof(rpc_tensor) + sizeof(cache_flag), sizeof(offset));
-    const size_t size = input.size() - header_size;
+    const size_t payload_size = input.size() - header_size;
 
     struct ggml_init_params params {
         /*.mem_size   =*/ ggml_tensor_overhead(),
@@ -1727,6 +1764,7 @@ bool rpc_server::set_tensor(const std::vector<uint8_t> & input) {
         LOG_ERROR("[%s] error deserializing tensor\n", __func__);
         return false;
     }
+    const size_t size = (cache_flag == 2) ? ((payload_size / sizeof(block_q12h)) * QK12H * sizeof(float)) : payload_size;
     LOG_DBG2("[%s] tensor: %s, buffer: %p, data: %p, offset: %" PRIu64 ", size: %s\n",
             __func__, rpc_log_format_tensor(tensor).c_str(), (void*)tensor->buffer, tensor->data, offset,
             rpc_log_format_size(size).c_str());
@@ -1744,6 +1782,12 @@ bool rpc_server::set_tensor(const std::vector<uint8_t> & input) {
     }
 
     const void * data = input.data() + header_size;
+    if (cache_flag == 2) {
+        std::vector<float> f32_buf(size / sizeof(float));
+        dequantize_row_q12h((const block_q12h *)data, f32_buf.data(), (int64_t)f32_buf.size());
+        ggml_backend_tensor_set(tensor, f32_buf.data(), offset, size);
+        return true;
+    }
     if (cache_dir && cache_flag) {
         uint64_t hash = fnv_hash((const uint8_t*)data, size);
         char hash_str[17];
@@ -1939,9 +1983,11 @@ bool rpc_server::get_tensor(const rpc_msg_get_tensor_req & request, std::vector<
         LOG_ERROR("[%s] error deserializing tensor\n", __func__);
         return false;
     }
+    const bool q12h_wire = (request.size & (1ULL << 62)) != 0;
+    const uint64_t real_size = request.size & ~(1ULL << 62);
     LOG_DBG2("[%s] tensor: %s, buffer: %p, data: %p, offset: %" PRIu64 ", size: %s\n", __func__,
              rpc_log_format_tensor(tensor).c_str(), (void*)tensor->buffer, tensor->data, request.offset,
-             rpc_log_format_size(request.size).c_str());
+             rpc_log_format_size(real_size).c_str());
 
     // sanitize tensor->data
     {
@@ -1950,15 +1996,25 @@ bool rpc_server::get_tensor(const rpc_msg_get_tensor_req & request, std::vector<
 
         if (request.tensor.data + request.offset < p0 ||
             request.tensor.data + request.offset >= p1 ||
-            request.size > (p1 - request.tensor.data - request.offset)) {
+            real_size > (p1 - request.tensor.data - request.offset)) {
                 LOG_ERROR("[%s] requested tensor region (data=0x%" PRIx64 ", offset=%" PRIu64 ", size=%" PRIu64 ") out of buffer bounds [0x%zx, 0x%zx)\n",
-                               __func__, request.tensor.data, request.offset, request.size, p0, p1);
+                               __func__, request.tensor.data, request.offset, real_size, p0, p1);
                 return false;
         }
     }
 
-    response.resize(request.size, 0);
-    ggml_backend_tensor_get(tensor, response.data(), request.offset, request.size);
+    if (q12h_wire) {
+        const size_t n_floats = real_size / sizeof(float);
+        const size_t q_bytes  = (n_floats / QK12H) * sizeof(block_q12h);
+        std::vector<float> f32_buf(n_floats);
+        ggml_backend_tensor_get(tensor, f32_buf.data(), request.offset, real_size);
+        response.resize(q_bytes);
+        quantize_row_q12h_ref(f32_buf.data(), (block_q12h *)response.data(), (int64_t)n_floats);
+        return true;
+    }
+
+    response.resize(real_size, 0);
+    ggml_backend_tensor_get(tensor, response.data(), request.offset, real_size);
     return true;
 }
 
