+                st.hits   += n_hit;
+                st.misses += n_miss;
+                st.bytes  += bytes;
+            }
+            l.shadow_ids.resize(ggml_nelements(sel));
+            ggml_backend_tensor_get_async(backend, sel, l.shadow_ids.data(), 0, ggml_nbytes(sel));
+            l.has_shadow = true;
+            ggml_backend_tensor_set_async(backend, dst, src->data, 0, ggml_nbytes(src));
