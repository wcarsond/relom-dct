@@ -736,9 +787,75 @@ struct llama_moe_cache::impl {
         // measured ~5 ms/token of uploads against ~24 ms/token of stalling, 48 times per token.
         // The hit rate logged at the end therefore covers the warm-up only; after the freeze the
         // split is static and its hit rate is whatever the warm-up happened to leave resident.
+        // PP -> TG Dimter Tooling-List Handoff:
+        // If the Roughing Pass (`PP`, large prompt batch) just ran and recorded its expert usage into `pp_counts`,
+        // immediately pack the VRAM cache with the Prompt's Top-K Superset ("Kicker Group Tooling List") in one
+        // merged burst before Token #1 of `TG` executes — with ZERO `ggml_backend_synchronize` stalls!
+        if (split && g.slru.needs_pp_handoff) {
+            g.slru.needs_pp_handoff = false;
+            struct cand { int32_t count; int32_t il; int32_t e; };
+            std::vector<cand> cands;
+            for (int32_t gil : g.layers) {
+                for (int32_t e = 0; e < g.slru.n_expert; ++e) {
+                    const int32_t c = g.slru.pp_counts[(size_t)gil * g.slru.n_expert + e];
+                    if (c > 0 && g.slru.slot_map[gil][e] < 0) {
+                        cands.push_back({ c, gil, e });
+                    }
+                }
+            }
+            std::sort(cands.begin(), cands.end(), [](const cand & a, const cand & b) { return a.count > b.count; });
+            // Fill all remaining empty slots first; if already full, replace up to 1/3 coldest unpinned slots
+            int32_t uploaded = 0;
+            for (size_t k = 0; k < cands.size(); ++k) {
+                const int32_t cil = cands[k].il;
+                const int32_t ce  = cands[k].e;
+                int32_t s = g.slru.empty_slot();
+                if (s < 0) {
+                    if (uploaded >= std::max(1, g.n_slots / 3)) {
+                        break;
+                    }
+                    s = g.slru.victim(cil);
+                    if (s < 0) break;
+                    const int32_t old_key = g.slru.key_of[s];
+                    if (old_key >= 0) {
+                        if (g.slru.reddit_score(cil, ce) <= g.slru.reddit_score(old_key / g.slru.n_expert, old_key % g.slru.n_expert)) {
+                            break;
+                        }
+                        g.slru.set_resident(old_key / g.slru.n_expert, old_key % g.slru.n_expert, -1);
+                    }
+                }
+                g.slru.key_of[s] = cil * g.slru.n_expert + ce;
+                g.slru.set_resident(cil, ce, s);
+                g.slru.move(s, true);
+                const layer & cl = layers[cil];
+                for (size_t ip = 0; ip < cl.experts.size(); ++ip) {
+                    const ggml_tensor * w    = cl.experts[ip];
+                    ggml_tensor       * bank = g.banks[ip];
+                    const size_t expert_size = w->nb[2];
+                    ggml_backend_tensor_set_async(backend, bank, (const uint8_t *) w->data + ce * expert_size, s * expert_size, expert_size);
+                }
+                uploaded++;
+            }
+            // PP FLUSH: Reset `pp_counts` AND flush `freq_score` down to a small seed (0.5f) so Rank-1
+            // (PP-only "Reader" experts that never fire in TG) have 0 `obj_score` and get kicked off
+            // first as soon as TG's Rank-3 ("Writer" experts) arrive, while Rank-2 ("Both") immediately
+            // build permanent `obj_score` on their first TG hit!
+            std::fill(g.slru.pp_counts.begin(), g.slru.pp_counts.end(), 0);
+            for (float & f : g.slru.freq_score) {
+                f = (f > 0.0f) ? 0.5f : 0.0f;
+            }
+            if (g.slru.full()) {
+                ggml_backend_tensor_set_async(backend, dst, src->data, 0, ggml_nbytes(src));
+                return true;
+            }
+        }
+
         // In default split mode, once full, the cache freezes to avoid the per-layer device synchronize.
-        // When GGML_MOE_DCT=1 is set, the cache uses periodic Reddit-score Clutch-B promotions (sampling
-        // every Nth token or when not yet full) so residency adapts to topic shifts without stalling every layer.
+        // When GGML_MOE_DCT=N is set, the cache acts like a Continuous 1-Cart Roller Coaster IN THE SHADOWS:
+        //   - Instead of calling `ggml_backend_synchronize(backend)` (which stops the GPU mid-token!),
+        //   - On token `t`, we queue a non-blocking `ggml_backend_tensor_get_async` into `l.shadow_ids` and return immediately!
+        //   - On token `t + N` (when token `t` has already finished!), `l.shadow_ids` is sitting in host RAM ready to read
+        //     with ZERO `ggml_backend_synchronize` stalls, and we promote 1 new Crew Cart into Clutch B!
         static const int dct_period = getenv("GGML_MOE_DCT") ? std::max(1, atoi(getenv("GGML_MOE_DCT"))) : 0;
         if (split && g.slru.full()) {
             if (dct_period == 0 || (++g.slru.step_clock % dct_period != 0)) {
@@ -862,6 +979,39 @@ struct llama_moe_cache::impl {
         }
         GGML_ASSERT(ggml_is_contiguous(sel));
 
+        if (split && g.slru.full()) {
+            // Zero-Stall Shadow Coaster ("What We Do in the Shadows"):
+            // Once the cache is full in split mode, NEVER call `ggml_backend_synchronize(backend)`!
+            // Instead, if `l.has_shadow` is true from an earlier token's async read, consume `l.shadow_ids`
+            // right now (the earlier token has long since completed!), promote 1 Crew Cart in the background,
+            // and queue a fresh non-blocking `ggml_backend_tensor_get_async` into `l.shadow_ids` for next time!
+            if (l.has_shadow) {
+                size_t n_hit  = 0;
+                size_t n_miss = 0;
+                g.slru.plan(il, l.shadow_ids.data(), l.shadow_ids.size(), fills, n_hit, n_miss);
+                plan_pending[il] = 1;
+                size_t bytes = 0;
+                for (size_t ip = 0; ip < l.experts.size(); ++ip) {
+                    const ggml_tensor * w    = l.experts[ip];
+                    ggml_tensor       * bank = g.banks[ip];
+                    const size_t expert_size = w->nb[2];
+                    for (size_t i = 0; i < fills.size(); ++i) {
+                        ggml_backend_tensor_set_async(backend, bank, (const uint8_t *) w->data + fills[i].expert*expert_size, fills[i].slot*expert_size, expert_size);
