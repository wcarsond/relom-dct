+        }
+        group & g = groups[layers[il].ig];
+        const int32_t n_exp = g.slru.n_expert;
+        for (size_t i = 0; i < n_ids; ++i) {
+            const int32_t e = ids_data[i];
+            if (e >= 0 && e < n_exp) {
+                g.slru.pp_counts[(size_t)il * n_exp + e]++;
+                g.slru.freq_score[(size_t)il * n_exp + e] += 1.0f;
+            }
+        }
+        g.slru.needs_pp_handoff = true;
+    }
