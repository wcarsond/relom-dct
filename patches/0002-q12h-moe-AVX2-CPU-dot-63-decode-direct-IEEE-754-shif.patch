+++ b/ggml/src/ggml-cpu/quants.c
@@ -203,6 +203,86 @@ void ggml_vec_dot_q12h_f32(int n, float * GGML_RESTRICT s, size_t bs, const void
     double acc0 = 0, acc1 = 0, acc2 = 0, acc3 = 0;
 
     for (int i = 0; i < nb; i++) {
+        const float * GGML_RESTRICT yb = y + (size_t)i*qk;
+#if defined(__AVX2__)
+        const __m128i mask_0f   = _mm_set1_epi8(0x0F);
+        const __m256i mask_sign = _mm256_set1_epi16((short)0x0080);
+        const __m256i mask_mant = _mm256_set1_epi16(0x007F);
+        __m256 c0 = _mm256_setzero_ps();
+        __m256 c1 = _mm256_setzero_ps();
+        __m256 c2 = _mm256_setzero_ps();
+        __m256 c3 = _mm256_setzero_ps();
+
+        if (x[i].lut[0] == Q12H_MODE_SHIFT) {
+            const __m128i v_emin = _mm_set1_epi8((char)x[i].lut[1]);
+            for (int j = 0; j < qk; j += 16) {
+                const __m128i raw_nib  = _mm_loadl_epi64((const __m128i *)(x[i].nib + (j >> 1)));
+                const __m128i nib_even = _mm_and_si128(raw_nib, mask_0f);
+                const __m128i nib_odd  = _mm_and_si128(_mm_srli_epi16(raw_nib, 4), mask_0f);
+                const __m128i ix_16    = _mm_unpacklo_epi8(nib_even, nib_odd);
+                const __m128i exp_8    = _mm_add_epi8(ix_16, v_emin);
+                const __m256i exp_16   = _mm256_slli_epi16(_mm256_cvtepu8_epi16(exp_8), 7);
+
+                const __m128i sm_8     = _mm_loadu_si128((const __m128i *)(x[i].sm + j));
+                const __m256i sm_16    = _mm256_cvtepu8_epi16(sm_8);
+                const __m256i sign_16  = _mm256_slli_epi16(_mm256_and_si256(sm_16, mask_sign), 8);
+                const __m256i mant_16  = _mm256_and_si256(sm_16, mask_mant);
+                const __m256i bf16_16  = _mm256_or_si256(_mm256_or_si256(sign_16, exp_16), mant_16);
+
+                const __m128i bf_lo    = _mm256_castsi256_si128(bf16_16);
+                const __m128i bf_hi    = _mm256_extracti128_si256(bf16_16, 1);
+                const __m256  wx0      = _mm256_castsi256_ps(_mm256_slli_epi32(_mm256_cvtepu16_epi32(bf_lo), 16));
+                const __m256  wx1      = _mm256_castsi256_ps(_mm256_slli_epi32(_mm256_cvtepu16_epi32(bf_hi), 16));
+                const __m256  wy0      = _mm256_loadu_ps(yb + j);
+                const __m256  wy1      = _mm256_loadu_ps(yb + j + 8);
+                if (j & 16) {
+                    c2 = _mm256_fmadd_ps(wx0, wy0, c2);
+                    c3 = _mm256_fmadd_ps(wx1, wy1, c3);
+                } else {
+                    c0 = _mm256_fmadd_ps(wx0, wy0, c0);
+                    c1 = _mm256_fmadd_ps(wx1, wy1, c1);
+                }
+            }
+        } else {
+            uint16_t bf[QK12H];
+            const __m128i v_lut = _mm_loadu_si128((const __m128i *)x[i].lut);
+            for (int j = 0; j < qk; j += 16) {
+                const __m128i raw_nib  = _mm_loadl_epi64((const __m128i *)(x[i].nib + (j >> 1)));
+                const __m128i nib_even = _mm_and_si128(raw_nib, mask_0f);
+                const __m128i nib_odd  = _mm_and_si128(_mm_srli_epi16(raw_nib, 4), mask_0f);
+                const __m128i ix_16    = _mm_unpacklo_epi8(nib_even, nib_odd);
+                const __m128i exp_8    = _mm_shuffle_epi8(v_lut, ix_16);
+                const __m256i exp_16   = _mm256_slli_epi16(_mm256_cvtepu8_epi16(exp_8), 7);
+
+                const __m128i sm_8     = _mm_loadu_si128((const __m128i *)(x[i].sm + j));
+                const __m256i sm_16    = _mm256_cvtepu8_epi16(sm_8);
+                const __m256i sign_16  = _mm256_slli_epi16(_mm256_and_si256(sm_16, mask_sign), 8);
+                const __m256i mant_16  = _mm256_and_si256(sm_16, mask_mant);
+                const __m256i bf16_16  = _mm256_or_si256(_mm256_or_si256(sign_16, exp_16), mant_16);
+                _mm256_storeu_si256((__m256i *)(bf + j), bf16_16);
+            }
+            for (int t = 0; t < 4; t++) {
+                const uint16_t v = x[i].eval[t];
+                if (v == Q12H_SLOT_EMPTY) break;
+                bf[x[i].epos[t]] = v;
+            }
+            for (int j = 0; j < qk; j += 32) {
+                const __m256 wx0 = _mm256_castsi256_ps(_mm256_slli_epi32(_mm256_cvtepu16_epi32(_mm_loadu_si128((const __m128i *)(bf + j))), 16));
+                const __m256 wx1 = _mm256_castsi256_ps(_mm256_slli_epi32(_mm256_cvtepu16_epi32(_mm_loadu_si128((const __m128i *)(bf + j + 8))), 16));
+                const __m256 wx2 = _mm256_castsi256_ps(_mm256_slli_epi32(_mm256_cvtepu16_epi32(_mm_loadu_si128((const __m128i *)(bf + j + 16))), 16));
+                const __m256 wx3 = _mm256_castsi256_ps(_mm256_slli_epi32(_mm256_cvtepu16_epi32(_mm_loadu_si128((const __m128i *)(bf + j + 24))), 16));
+                c0 = _mm256_fmadd_ps(wx0, _mm256_loadu_ps(yb + j),      c0);
+                c1 = _mm256_fmadd_ps(wx1, _mm256_loadu_ps(yb + j + 8),  c1);
+                c2 = _mm256_fmadd_ps(wx2, _mm256_loadu_ps(yb + j + 16), c2);
+                c3 = _mm256_fmadd_ps(wx3, _mm256_loadu_ps(yb + j + 24), c3);
+            }
+        }
+        const __m256 csum = _mm256_add_ps(_mm256_add_ps(c0, c2), _mm256_add_ps(c1, c3));
+        __m128 g = _mm_add_ps(_mm256_extractf128_ps(csum, 1), _mm256_castps256_ps128(csum));
+        g = _mm_add_ps(g, _mm_movehl_ps(g, g));
+        g = _mm_add_ss(g, _mm_movehdup_ps(g));
+        acc0 += (double)_mm_cvtss_f32(g);
+#else
         // Decoded here rather than through dequantize_row_q12h() so the loop stays
         // in this translation unit and keeps vectorising - calling across to
         // ggml-quants.c costs about 2.6x on this path.
@@ -227,20 +307,21 @@ void ggml_vec_dot_q12h_f32(int n, float * GGML_RESTRICT s, size_t bs, const void
                 memcpy(&xb[j], &u, sizeof(float));
             }
             for (int t = 0; t < 4; t++) {
+                const uint16_t v = x[i].eval[t];
+                if (v == Q12H_SLOT_EMPTY) break;   // the marker is in the value; 0xFF is a legal position
                 const uint8_t p = x[i].epos[t];
-                if (p == 0xFF) break;
-                const uint32_t u = (uint32_t)x[i].eval[t] << 16;
+                const uint32_t u = (uint32_t)v << 16;
                 memcpy(&xb[p], &u, sizeof(float));
             }
         }
 
-        const float * GGML_RESTRICT yb = y + (size_t)i*qk;
         for (int j = 0; j < qk; j += 4) {
             acc0 += (double)(xb[j    ] * yb[j    ]);
             acc1 += (double)(xb[j + 1] * yb[j + 1]);
             acc2 += (double)(xb[j + 2] * yb[j + 2]);
             acc3 += (double)(xb[j + 3] * yb[j + 3]);
         }
+#endif
     }
 
     *s = (float)(acc0 + acc1 + acc2 + acc3);
