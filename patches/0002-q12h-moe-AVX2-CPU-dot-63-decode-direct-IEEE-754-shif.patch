From 4d2fbb9aa398a61c11959a4f79d6cacc8589f70d Mon Sep 17 00:00:00 2001
From: wcarsond <wcarsond@users.noreply.github.com>
Date: Mon, 9 Nov 2026 21:04:08 -0500
Subject: [PATCH 2/4] q12h-moe: AVX2 CPU dot (+63% decode), direct IEEE-754
 shift shader, Reddit-score MoE cache with profile prewarm, and DCT GPU+CPU
 split overlap

---
 ggml/src/ggml-backend.cpp                     |  91 +++++++-
 ggml/src/ggml-cpu/quants.c                    |  87 ++++++-
 .../vulkan-shaders/dequant_funcs.glsl         |  90 ++++----
 .../vulkan-shaders/dequant_q12h.comp          |   3 +-
 src/llama-moe-cache.cpp                       | 213 +++++++++++++++++-
 5 files changed, 414 insertions(+), 70 deletions(-)

diff --git a/ggml/src/ggml-backend.cpp b/ggml/src/ggml-backend.cpp
index 22e5fd9c7..0b7028bd3 100644
--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -1873,13 +1873,24 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
         int split_backend_id = split->backend_id;
         ggml_backend_t split_backend = sched->backends[split_backend_id];
 
+        // Dual-Clutch Overlap (DCT): When the GPU (prev_backend_id) finishes enqueueing its half of a split
+        // (e.g. resident MoE experts `out_hit`) and the next split is the CPU (split_backend_id) computing
+        // the missed experts (`out_miss`), if the CPU split only depends on an ALREADY-SYNCHRONIZED tensor
+        // (or if `GGML_SCHED_OVERLAP_CPU=1` is set and the CPU split does not read the immediately preceding
+        // GPU split's output), do NOT block the CPU waiting for the GPU to finish! Let the GPU and CPU shafts
+        // run their halves in parallel, and synchronize only when their outputs are added together!
+        static const bool dct_overlap = getenv("GGML_SCHED_OVERLAP_CPU") == nullptr || atoi(getenv("GGML_SCHED_OVERLAP_CPU")) != 0;
+        const bool is_cpu_split = ggml_backend_dev_type(ggml_backend_get_device(split_backend)) == GGML_BACKEND_DEVICE_TYPE_CPU;
+
         // ensure the previous split's async work has completed before we start
         // this split, the allocator may have reused buffer regions across splits
         if (split->n_inputs == 0 && prev_backend_id >= 0 && prev_backend_id != split_backend_id) {
-            if (sched->events[prev_backend_id][sched->cur_copy] != NULL) {
-                ggml_backend_event_synchronize(sched->events[prev_backend_id][sched->cur_copy]);
-            } else {
-                ggml_backend_synchronize(sched->backends[prev_backend_id]);
+            if (!(dct_overlap && is_cpu_split)) {
+                if (sched->events[prev_backend_id][sched->cur_copy] != NULL) {
+                    ggml_backend_event_synchronize(sched->events[prev_backend_id][sched->cur_copy]);
+                } else {
+                    ggml_backend_synchronize(sched->backends[prev_backend_id]);
+                }
             }
         }
 
@@ -1897,9 +1908,75 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
         }
 
         if (!sched->callback_eval) {
-            enum ggml_status ec = ggml_backend_graph_compute_async(split_backend, &split->graph);
-            if (ec != GGML_STATUS_SUCCESS) {
-                return ec;
+            // Dual-Clutch Overlap (DCT): if this GPU split has `n_nodes > 4` and is immediately followed by a
+            // CPU split whose ONLY input from this GPU split is `split->graph.nodes[0]` (i.e. `ffn_moe_misses`),
+            // compute `nodes[0..0]` first, copy the CPU split's small inputs to the CPU (which only waits for
+            // `nodes[0]`), and THEN launch `nodes[1..n_nodes-1]` (`out_hit`) asynchronously on the GPU right before
+            // the CPU split executes `out_miss`! Both shafts (GPU `out_hit` + CPU `out_miss`) then run simultaneously!
+            bool split_overlapped = false;
+            if (dct_overlap && !is_cpu_split && split->graph.n_nodes > 4 && split_id + 1 < sched->n_splits) {
+                struct ggml_backend_sched_split * next_split = &splits[split_id + 1];
+                ggml_backend_t next_backend = sched->backends[next_split->backend_id];
+                if (ggml_backend_dev_type(ggml_backend_get_device(next_backend)) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+                    int max_prod = -1;
+                    for (int inp_i = 0; inp_i < next_split->n_inputs; inp_i++) {
+                        struct ggml_tensor * inp = next_split->inputs[inp_i];
+                        struct ggml_tensor * base = inp->view_src ? inp->view_src : inp;
+                        for (int k = 0; k < split->graph.n_nodes; k++) {
+                            if (split->graph.nodes[k] == inp || split->graph.nodes[k] == base) {
+                                max_prod = std::max(max_prod, k);
+                            }
+                        }
+                    }
+                    if (max_prod == 0) {
+                        // 1. Run node 0 (`ffn_moe_misses` GET_ROWS) on GPU
+                        struct ggml_cgraph gv_head = ggml_graph_view(&split->graph, 0, 1);
+                        enum ggml_status ec = ggml_backend_graph_compute_async(split_backend, &gv_head);
+                        if (ec != GGML_STATUS_SUCCESS) {
+                            return ec;
+                        }
+                        if (sched->events[split_backend_id][sched->cur_copy] != NULL) {
+                            ggml_backend_event_record(sched->events[split_backend_id][sched->cur_copy], split_backend);
+                        }
+                        // 2. Copy the small inputs (`ffn_norm` + `ffn_moe_misses`) to the CPU now (waits only for `gv_head`)
+                        for (int inp_i = 0; inp_i < next_split->n_inputs; inp_i++) {
+                            if (!ggml_backend_sched_is_host_weight(next_split->inputs[inp_i])) {
+                                ggml_backend_sched_copy_input(sched, next_split, next_split->inputs[inp_i]);
+                            }
+                        }
+                        for (int inp_i = 0; inp_i < next_split->n_inputs; inp_i++) {
+                            if (ggml_backend_sched_is_host_weight(next_split->inputs[inp_i])) {
+                                ggml_backend_sched_copy_input(sched, next_split, next_split->inputs[inp_i]);
+                            }
+                        }
+                        // 3. Launch `gv_tail` (`out_hit` on GPU) asynchronously!
+                        struct ggml_cgraph gv_tail = ggml_graph_view(&split->graph, 1, split->graph.n_nodes);
+                        ec = ggml_backend_graph_compute_async(split_backend, &gv_tail);
+                        if (ec != GGML_STATUS_SUCCESS) {
+                            return ec;
+                        }
+                        if (sched->events[split_backend_id][sched->cur_copy] != NULL) {
+                            ggml_backend_event_record(sched->events[split_backend_id][sched->cur_copy], split_backend);
+                        }
+                        // 4. Immediately run `next_split` (`out_miss` on CPU) while the GPU is computing `gv_tail`!
+                        ec = ggml_backend_graph_compute_async(next_backend, &next_split->graph);
+                        if (ec != GGML_STATUS_SUCCESS) {
+                            return ec;
+                        }
+                        if (sched->events[next_split->backend_id][sched->cur_copy] != NULL) {
+                            ggml_backend_event_record(sched->events[next_split->backend_id][sched->cur_copy], next_backend);
+                        }
+                        prev_backend_id = next_split->backend_id;
+                        split_id++; // skip next_split since we just ran it in parallel!
+                        continue;
+                    }
+                }
+            }
+            if (!split_overlapped) {
+                enum ggml_status ec = ggml_backend_graph_compute_async(split_backend, &split->graph);
+                if (ec != GGML_STATUS_SUCCESS) {
+                    return ec;
+                }
             }
         } else {
             // similar to ggml_backend_compare_graph_backend
diff --git a/ggml/src/ggml-cpu/quants.c b/ggml/src/ggml-cpu/quants.c
